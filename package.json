{
  "name": "fishing-app",
  "version": "1.0.0",
  "description": "Community-focused fishing app with affordable pricing",
  "private": true,
  "workspaces": [
    "backend",
    "mobile",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:mobile\"",
    "dev:web": "concurrently \"npm run dev:backend\" \"npm run web --workspace=mobile\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:mobile": "npm run start --workspace=mobile",
    "web": "npm run web --workspace=mobile",
    "build": "npm run build --workspace=backend && npm run build --workspace=mobile",
    "build:web": "npm run web --workspace=mobile -- --no-dev --minify",
    "test": "npm run test --workspaces",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  }
}
